App(
    appid="flipmesh_bt",
    name="FlipMesh BLE",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipmesh_bt_app_entry",
    requires=["gui"],
    stack_size=14 * 1024,
    fap_icon="icons/flipmesh_10.png",
    fap_category="Tools",
    fap_author="DanilaE",
    fap_weburl="https://github.com/DanilaE/FlipMesh",
    fap_version="1.0",
    fap_description="Meshtastic client (BLE transport — stub on stock FW)",
    sources=["*.c"],
    cdefines=["FM_APP_BT=1"],
    fap_private_libs=[
        Lib(
            sources=["*.c"],
            name="nanopb",
            cflags=[],
        ),
        Lib(
            sources=["meshtastic/*.pb.c"],
            name="meshtastic_api",
            cflags=[],
        ),
        Lib(
            sources=["*.c"],
            name="flipmesh_core",
            cincludes=["../../core"],
            cflags=[],
        ),
    ],
)
